# Copy to .env (never commit .env) and fill in real values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=change_me

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Milliseconds (3600000 = 1 hour)
JWT_EXPIRATION=3600000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: creates ONE admin on first start if the email does not exist yet.
# Password must be 12+ chars. Remove these two lines after the first run.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
